# Never commit real credentials. Copy these values into .env.local for local development.
MONGODB_URI=
JWT_SECRET=

# School Gmail / Google Workspace SMTP configuration for password-reset codes.
# Use an App Password, not the Gmail account's normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-school-email@phinmaed.com
SMTP_PASS=
SMTP_FROM="CITEMAS Portal <your-school-email@phinmaed.com>"

# Used to hash password-reset codes. Generate a separate long random secret.
PASSWORD_RESET_SECRET=
